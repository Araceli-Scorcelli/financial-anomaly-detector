# Copiar a .env en la raíz del proyecto y completar los datos locales.
# La contraseña real se escribe únicamente en .env, que está excluido de Git.
# Fuente del dashboard: postgres (predeterminada) o csv (no requiere credenciales).
# DATA_SOURCE definido en PowerShell tiene prioridad y permite omitir .env.
DATA_SOURCE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_anomalies
DB_USER=
DB_PASSWORD=
